{
  "_meta": {
    "project_name": "Acme App",
    "project_slug": "acme-app",
    "handbook_version": "v1.1.0",
    "bootstrapped_at": "2025-03-19T09:00:00Z",
    "manifest_version": "1.0.0",
    "schema": "https://github.com/nicolapitersky/Bible/blob/main/schemas/env-manifest.schema.json"
  },
  "environments": {
    "local": {
      "label": "Local Development",
      "firebase": {
        "projectId": "acme-app-staging",
        "appId": "1:000000000000:web:staging00000000",
        "storageBucket": "acme-app-staging.appspot.com",
        "databaseId": "(default)",
        "region": "europe-west2"
      },
      "supabase": {
        "projectRef": "localreflocallocallocal",
        "region": "eu-west-2"
      },
      "stripe": {
        "mode": "test",
        "webhookEndpoint": "http://localhost:3000/api/webhooks/stripe"
      }
    },
    "staging": {
      "label": "Staging",
      "firebase": {
        "projectId": "acme-app-staging",
        "appId": "1:000000000000:web:staging00000000",
        "storageBucket": "acme-app-staging.appspot.com",
        "databaseId": "(default)",
        "region": "europe-west2"
      },
      "vercel": {
        "teamSlug": "acme-team",
        "projectId": "prj_STAGING00000000000000000",
        "deploymentUrl": "https://acme-app-staging.vercel.app"
      },
      "supabase": {
        "projectRef": "stagingrefstagingrefstagingr",
        "region": "eu-west-2"
      },
      "stripe": {
        "mode": "test",
        "webhookEndpoint": "https://acme-app-staging.vercel.app/api/webhooks/stripe"
      }
    },
    "production": {
      "label": "Production",
      "firebase": {
        "projectId": "acme-app-prod",
        "appId": "1:111111111111:web:prod111111111111",
        "storageBucket": "acme-app-prod.appspot.com",
        "databaseId": "(default)",
        "region": "europe-west2"
      },
      "vercel": {
        "teamSlug": "acme-team",
        "projectId": "prj_PROD000000000000000000000",
        "deploymentUrl": "https://app.acme.app"
      },
      "supabase": {
        "projectRef": "prodrefprodrefprodrefprodre",
        "region": "eu-west-2"
      },
      "stripe": {
        "mode": "live",
        "webhookEndpoint": "https://app.acme.app/api/webhooks/stripe"
      }
    }
  },
  "guards": {
    "productionRequiresExplicitConfirmation": true,
    "stagingAllowedBranches": ["staging", "release/*"],
    "productionAllowedBranches": ["main"],
    "disallowedPatterns": [
      "acme-app-prod",
      "acme-app-staging",
      "prj_PROD",
      "prj_STAGING"
    ]
  }
}
