{
  "name": "acme-app",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev":          "next dev",
    "build":        "pnpm prebuild && next build",
    "prebuild":     "node scripts/generate-tokens.js && node scripts/verify-env.js ${NODE_ENV:-local}",
    "start":        "next start",
    "type-check":   "tsc --noEmit",
    "lint":         "next lint --max-warnings=0",
    "format":       "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit":    "vitest run",
    "test:e2e":     "playwright test",
    "quality":      "node scripts/weekly-quality.js",
    "tokens":       "node scripts/generate-tokens.js",
    "emulators":    "firebase emulators:start --import ./emulator-data --export-on-exit"
  },
  "dependencies": {
    "next":                      "^15.0.0",
    "react":                     "^19.0.0",
    "react-dom":                 "^19.0.0",
    "firebase":                  "^10.12.0",
    "firebase-admin":            "^12.0.0",
    "@supabase/supabase-js":     "^2.43.0",
    "@supabase/ssr":             "^0.3.0",
    "stripe":                    "^16.0.0",
    "@stripe/stripe-js":         "^4.0.0",
    "@stripe/react-stripe-js":   "^2.7.0",
    "@tanstack/react-query":     "^5.40.0",
    "react-hook-form":           "@7.52.0",
    "zod":                       "^3.23.0",
    "@hookform/resolvers":       "^3.6.0",
    "pino":                      "^9.2.0",
    "pino-pretty":               "^11.0.0",
    "date-fns":                  "^3.6.0",
    "@vercel/analytics":         "^1.3.0",
    "@vercel/speed-insights":    "^1.0.0",
    "server-only":               "^0.0.1"
  },
  "devDependencies": {
    "@types/node":                     "^22.0.0",
    "@types/react":                    "^19.0.0",
    "@types/react-dom":                "^19.0.0",
    "typescript":                      "^5.5.0",
    "tailwindcss":                     "^3.4.0",
    "@tailwindcss/typography":         "^0.5.0",
    "autoprefixer":                    "^10.4.0",
    "postcss":                         "^8.4.0",
    "@typescript-eslint/eslint-plugin":"^7.0.0",
    "@typescript-eslint/parser":       "^7.0.0",
    "eslint":                          "^8.57.0",
    "eslint-config-next":              "^15.0.0",
    "prettier":                        "^3.3.0",
    "vitest":                          "^1.6.0",
    "@testing-library/react":          "^16.0.0",
    "@testing-library/user-event":     "^14.5.0",
    "msw":                             "^2.3.0",
    "@playwright/test":                "^1.44.0",
    "lefthook":                        "^1.6.0"
  }
}
