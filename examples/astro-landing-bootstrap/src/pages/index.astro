---
/**
 * src/pages/index.astro — Homepage
 *
 * Every visual value uses design tokens.
 * Every component comes from the component library.
 * SEO complete: title, description, OG, structured data.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Section from '../components/ui/Section.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import Features from '../components/sections/Features.astro';
import SocialProof from '../components/sections/SocialProof.astro';
import CTA from '../components/sections/CTA.astro';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Acme',
  url: 'https://acme.app',
  description: 'The platform that powers modern teams.',
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: 'https://acme.app/search?q={search_term_string}',
    },
    'query-input': 'required name=search_term_string',
  },
};
---

<BaseLayout
  title="Acme — The platform that powers modern teams"
  description="Acme helps teams ship faster, collaborate better, and build products their customers love. Join 10,000+ teams already using Acme."
  structuredData={structuredData}
>
  <Nav />

  <main id="main-content">
    <Hero />
    <Features />
    <SocialProof />
    <CTA />
  </main>

  <Footer />
</BaseLayout>
