# Acme Landing — Environment Variables
# Copy to .env.local and fill in values
# NEVER commit .env.local

# Runtime environment
NODE_ENV=

# This is a static Astro site with no backend.
# The only secrets needed are for build-time analytics and forms.

# Netlify (set in Netlify dashboard, not here)
# NETLIFY_AUTH_TOKEN=    ← set in Netlify dashboard or CI env
# NETLIFY_SITE_ID=       ← set in CI env (see .env.manifest for IDs)

# If adding a contact form service:
# FORM_SERVICE_API_KEY=

# If adding analytics:
# ANALYTICS_WRITE_KEY=
